<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Header: brand + hora -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FinancyAI"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:alpha="0.75"/>

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:alpha="0.55"/>
    </LinearLayout>

    <!-- Label balance -->
    <TextView
        android:id="@+id/widget_balance_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BALANCE DISPONIBLE"
        android:textColor="#FFFFFF"
        android:textSize="8sp"
        android:alpha="0.65"
        android:letterSpacing="0.08"
        android:layout_marginBottom="2dp"/>

    <!-- Monto balance -->
    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Barra de presupuesto -->
    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:progressDrawable="@drawable/widget_progress_drawable"
        android:max="100"
        android:layout_marginBottom="10dp"/>

    <!-- Fila inferior: gasto hoy | racha | próximo pago -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Gasto hoy -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_pill"
            android:padding="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOY"
                android:textColor="#FFFFFF"
                android:textSize="7sp"
                android:alpha="0.65"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/widget_hoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <View android:layout_width="5dp" android:layout_height="1dp"/>

        <!-- Racha -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_pill"
            android:padding="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RACHA"
                android:textColor="#FFFFFF"
                android:textSize="7sp"
                android:alpha="0.65"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/widget_racha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <View android:layout_width="5dp" android:layout_height="1dp"/>

        <!-- Próximo pago -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_pill"
            android:padding="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRÓXIMO"
                android:textColor="#FFFFFF"
                android:textSize="7sp"
                android:alpha="0.65"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/widget_pago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
