{
  "expo": {
    "name": "finanzas-personales",
    "slug": "finanzas-personales",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finanzaspersonales",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.financyai.finanzaspersonales",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "FinancyAI usa el micrófono para que puedas registrar gastos e ingresos con tu voz.",
        "NSCameraUsageDescription": "FinancyAI puede usar la cámara para escanear recibos.",
        "NSUserNotificationsUsageDescription": "FinancyAI te enviará recordatorios de pagos, alertas de presupuesto y resúmenes financieros."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.financyai.finanzaspersonales"
        ]
      }
    },
    "android": {
      "package": "com.financyai.finanzaspersonales",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single-page",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#6156E8",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "FinancyAI usa el micrófono para que puedas registrar gastos e ingresos con tu voz."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "abe447e0-25aa-4cdc-b4ae-8aeec08898ed"
      }
    },
    "owner": "maomix96"
  }
}
